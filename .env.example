APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# This site has no database — fleet, FAQs, testimonials, locations and site
# details are static config (config/fleet.php, config/site.php, etc.), and
# booking/quote/contact submissions are emailed rather than stored.

# Where booking, quote and contact submissions are emailed. Leave it blank to
# send them to SITE_EMAIL; set it only if you want enquiries going somewhere
# other than the address shown on the site.
BOOKING_NOTIFICATION_EMAIL=
SITE_EMAIL=enquiries@brittravel.co.uk
SITE_PHONE="01206 591149"
SITE_WHATSAPP_NUMBER="+44 7348 656810"

# Browser key for the Places (New) address autocomplete on the booking/quote
# forms. Public by design — restrict it by HTTP referrer in Google Cloud.
GOOGLE_MAPS_API_KEY=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# The notification email IS the booking — nothing is stored — so these have to
# be right. Verify them after any change with: php artisan mail:test you@you.com
#
# MAIL_SCHEME only accepts "smtp" or "smtps"; "tls" and "ssl" are not schemes
# and will throw UnsupportedSchemeException on the first send. Hostinger takes
# 465 with smtps, or 587 with smtp if the host blocks 465.
#
# MAIL_USERNAME is the full mailbox address, and MAIL_FROM_ADDRESS should match
# it — sending as an address the mailbox doesn't own fails SPF and lands in spam.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=enquiries@brittravel.co.uk
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="enquiries@brittravel.co.uk"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
